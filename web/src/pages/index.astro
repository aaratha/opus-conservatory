---
import { Image } from 'astro:assets';
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import HeroImage from '../assets/hero-piano.jpeg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugify } from '../lib/slugify';

const HOME_LOCATIONS_QUERY = defineQuery(
	`*[_type == "location"] | order(name asc){ _id, name, slug, address, phone, hours }`
);
const locations = await sanityClient.fetch(HOME_LOCATIONS_QUERY).catch(() => []);

const instruments = [
	'Piano',
	'Voice',
	'Guitar',
	'Violin',
	'Cello',
	'Flute',
	'Clarinet',
	'Percussion',
	'Ukulele',
	'Cuatro',
];

const programs = [
	{
		href: '/programs/private-lessons',
		title: 'Private Lessons',
		blurb: 'One-on-one instruction in 30, 45, or 60-minute sessions, matched to each student’s goals and pace.',
	},
	{
		href: '/programs/adaptive-lessons',
		title: 'Adaptive Lessons',
		blurb: 'Individualized instruction for students with learning differences, disabilities, or medical conditions, taught by board-certified music therapists.',
	},
	{
		href: '/programs/music-therapy',
		title: 'Music Therapy',
		blurb: 'Evidence-based sessions guided by board-certified therapists to support growth, healing, and development — no diagnosis required.',
	},
	{
		href: '/programs/summer-camp',
		title: 'Summer Camp',
		blurb: 'A different musical theme every week, from big-band improvisation to scoring for film.',
	},
	{
		href: '/recitals',
		title: 'Recitals',
		blurb: 'Regular performance opportunities where students share what they’ve been working on.',
	},
];

const whyOpus = [
	'Students are motivated and challenged. They achieve self-discipline and expand their creativity.',
	'Students make friends and meet musicians from all walks of life.',
	'Students develop their performance and communication skills through concerts and recitals.',
	'It’s possible to start learning to play an instrument at any age — our methodology adapts to improve each student’s knowledge.',
];

const faqs = [
	{
		question: 'What can a 3-year-old learn in music lessons?',
		answer:
			'Our curriculum introduces young students to rhythm and beats, recognizing sounds and melodies, fun activities that build fine motor skills, and the foundation for instrument playing and music appreciation.',
	},
	{
		question: 'My child faces unique challenges. Is there a place for them at Opus?',
		answer:
			'Absolutely. We’ve been teaching children with unique strengths and challenges for years — including students on the spectrum, students who are anxious, and students with physical challenges — through Adaptive Lessons led by our music therapists. Our facilities are fully ADA compliant, with wide doors, large classrooms, ramps, and accessible bathrooms, and we can schedule mornings or weekends for more privacy.',
	},
	{
		question: 'Why start music education so early?',
		answer:
			'Research shows early music education boosts cognitive development (memory, focus, problem-solving), creativity and self-expression, social-emotional growth (confidence, patience, teamwork), and motor skills through hands-on practice.',
	},
	{
		question: 'Can I try before committing?',
		answer:
			'Yes — we offer a free trial lesson so a new student can experience the joy of music firsthand and see if they’re ready to begin their musical journey with us.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-media">
					<Image src={HeroImage} alt="" width={1500} height={500} class="hero-banner" />
				</div>
				<div class="hero-content">
					<h1>Individualized music lessons for children and adults</h1>
					<p class="lede">
						A place where every student is unique in their own way — and so are our teaching styles
						and methods. Explore personalized music education with talented instructors at our
						RCM-certified school, across two Virginia studios since 2008.
					</p>
					<div class="hero-actions">
						<a class="button" href="/free-trial">Book a Free Trial</a>
						<a class="button button-outline" href="/instructors">Meet the Instructors</a>
					</div>
				</div>
			</section>

			<section class="why-opus">
				<h2>Why choose Opus?</h2>
				<ul class="why-opus-list">
					{whyOpus.map((point) => <li>{point}</li>)}
				</ul>
			</section>

			<section class="instruments">
				<h2>Instruments we teach</h2>
				<ul class="instrument-pills">
					{
						instruments.map((instrument) => (
							<li>
								<a href={`/instructors/?instrument=${slugify(instrument)}`}>{instrument}</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="programs">
				<h2>Programs</h2>
				<div class="program-grid">
					{
						programs.map((program) => (
							<a class="program-card" href={program.href}>
								<h3>{program.title}</h3>
								<p>{program.blurb}</p>
								<span class="learn-more">Learn more &rarr;</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="locations">
				<h2>Our studios</h2>
				<div class="location-grid">
					{
						locations.length > 0 ? (
							locations.map((loc) => (
								<div class="location-card">
									<h3>{loc.name}</h3>
									{loc.address && <p class="detail">{loc.address}</p>}
									{loc.phone && (
										<p class="detail">
											<a href={`tel:${loc.phone.replace(/[^\d+]/g, '')}`}>{loc.phone}</a>
										</p>
									)}
									{loc.hours && loc.hours.length > 0 && (
										<ul class="hours">
											{loc.hours.map((line) => <li>{line}</li>)}
										</ul>
									)}
									<a class="learn-more" href={`/instructors/?location=${loc.slug.current}`}>
										See {loc.name} instructors &rarr;
									</a>
								</div>
							))
						) : (
							<p>Studio locations are managed in Sanity — add a "Location" entry to show it here.</p>
						)
					}
				</div>
			</section>

			<section class="faq">
				<h2>Frequently asked questions</h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details class="faq-item">
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))
					}
				</div>
			</section>

			<section class="cta-banner">
				<h2>Ready to try a lesson?</h2>
				<p>Your first lesson is on us — tell us your instrument and preferred studio, and we’ll pair you with an instructor.</p>
				<a class="button" href="/free-trial">Book a Free Trial</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const heroBanner = document.querySelector<HTMLElement>('.hero-banner');

	if (heroBanner && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const speed = 0.35;
		let ticking = false;

		const updateParallax = () => {
			heroBanner.style.transform = `translateY(${window.scrollY * speed}px)`;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(updateParallax);
			},
			{ passive: true }
		);
	}
</script>

<style>
	section {
		margin-bottom: 4rem;
	}

	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		margin-top: -3em;
	}
	.hero-media {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}
	.hero-banner {
		position: absolute;
		top: -15%;
		left: 0;
		width: 100%;
		height: 130%;
		object-fit: cover;
		border-radius: 0;
		will-change: transform;
	}
	.hero-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.4) 45%, rgba(0, 0, 0, 0.65));
	}
	.hero::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -30px;
		height: 70px;
		background: radial-gradient(
			ellipse at center,
			rgba(35, 55, 255, 0.22),
			rgba(168, 85, 247, 0.12) 45%,
			transparent 75%
		);
		filter: blur(20px);
		pointer-events: none;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		padding: 5rem 2rem;
	}
	.hero h1 {
		max-width: 780px;
		margin: 0 auto 0.75rem;
		color: white;
	}
	.lede {
		max-width: 640px;
		margin: 0 auto 1.5rem;
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
	}
	.hero-content .lede {
		color: rgba(255, 255, 255, 0.9);
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.button {
		display: inline-block;
		padding: 0.75em 1.5em;
		border-radius: 999px;
		background: var(--accent);
		color: white;
		font-weight: 700;
		text-decoration: none;
		border: 2px solid transparent;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease,
			transform 0.2s ease, box-shadow 0.2s ease;
	}
	.button:hover {
		background: var(--accent-dark);
		color: white;
		transform: translateY(-2px);
	}
	.button-outline {
		background: transparent;
		color: var(--accent);
		border: 2px solid var(--accent);
	}
	.button-outline:hover {
		background: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	.hero-actions .button {
		background: white;
		color: var(--accent-dark);
		border-color: white;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}
	.hero-actions .button:hover {
		background: var(--accent);
		color: white;
		border-color: var(--accent);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
	}
	.hero-actions .button-outline {
		background: rgba(255, 255, 255, 0.1);
		color: white;
		border-color: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}
	.hero-actions .button-outline:hover {
		background: white;
		color: var(--accent-dark);
		border-color: white;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
	}

	h2 {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.why-opus-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.why-opus-list li {
		padding: 1.25rem;
		border-radius: 14px;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 4%);
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}

	.instrument-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		justify-content: center;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.instrument-pills a {
		display: inline-block;
		padding: 0.5em 1.1em;
		border-radius: 999px;
		background: white;
		border: 1px solid rgba(var(--gray), 20%);
		font-weight: 600;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.instrument-pills a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.program-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}
	.program-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		border-radius: 14px;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 4%);
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.program-card:hover {
		box-shadow: 0 8px 20px rgba(var(--black), 8%);
		transform: translateY(-2px);
	}
	.program-card h3 {
		margin: 0;
		color: var(--black);
	}
	.program-card p {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray));
		flex-grow: 1;
	}
	.learn-more {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
	}

	.location-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}
	.location-card {
		padding: 1.5rem;
		border-radius: 14px;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 4%);
	}
	.location-card h3 {
		margin-top: 0;
	}
	.location-card .detail {
		margin: 0.25rem 0;
		color: rgb(var(--gray-dark));
	}
	.hours {
		list-style: none;
		margin: 0.75rem 0;
		padding: 0;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.hours li {
		margin-bottom: 0.15rem;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 720px;
		margin: 0 auto;
	}
	.faq-item {
		padding: 1rem 1.25rem;
		border-radius: 12px;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 4%);
	}
	.faq-item summary {
		cursor: pointer;
		font-weight: 600;
		list-style: none;
	}
	.faq-item summary::-webkit-details-marker {
		display: none;
	}
	.faq-item summary::before {
		content: '▸';
		display: inline-block;
		margin-right: 0.5em;
		transition: transform 0.15s ease;
	}
	.faq-item[open] summary::before {
		transform: rotate(90deg);
	}
	.faq-item p {
		margin: 0.75rem 0 0;
		color: rgb(var(--gray-dark));
	}

	.cta-banner {
		text-align: center;
		padding: 3rem 2rem;
		border-radius: 20px;
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		color: white;
	}
	.cta-banner h2 {
		color: white;
	}
	.cta-banner p {
		max-width: 520px;
		margin: 0 auto 1.5rem;
	}
	.cta-banner .button {
		background: white;
		color: var(--accent-dark);
	}
	.cta-banner .button:hover {
		background: rgb(var(--gray-light));
		color: var(--accent-dark);
	}

	@media (max-width: 640px) {
		.hero-content {
			padding: 3rem 1.25rem;
		}
	}
</style>
