---
import { Image } from 'astro:assets';
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import HeroImage from '../assets/hero-piano.jpeg';
import MosaicCalendar from '../assets/mosaic-calendar.jpg';
import MosaicGuitar from '../assets/mosaic-guitar.jpg';
import MosaicKeys from '../assets/mosaic-keys.jpg';
import MosaicPastEvents from '../assets/mosaic-past-events.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Piano from '../components/Piano.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugify } from '../lib/slugify';

const HOME_LOCATIONS_QUERY = defineQuery(
	`*[_type == "location"] | order(name asc){ _id, name, slug, address, phone, hours }`
);
const locations = await sanityClient.fetch(HOME_LOCATIONS_QUERY).catch(() => []);

const instruments = [
	'Piano',
	'Voice',
	'Guitar',
	'Violin',
	'Cello',
	'Flute',
	'Clarinet',
	'Percussion',
	'Ukulele',
	'Cuatro',
];

const programs = [
	{
		href: '/programs/private-lessons',
		title: 'Private Lessons',
		blurb: 'One-on-one instruction in 30, 45, or 60-minute sessions, matched to each student’s goals and pace.',
	},
	{
		href: '/programs/adaptive-lessons',
		title: 'Adaptive Lessons',
		blurb: 'Individualized instruction for students with learning differences, disabilities, or medical conditions, taught by board-certified music therapists.',
	},
	{
		href: '/programs/music-therapy',
		title: 'Music Therapy',
		blurb: 'Evidence-based sessions guided by board-certified therapists to support growth, healing, and development — no diagnosis required.',
	},
	{
		href: '/programs/summer-camp',
		title: 'Summer Camp',
		blurb: 'A different musical theme every week, from big-band improvisation to scoring for film.',
	},
	{
		href: '/recitals',
		title: 'Recitals',
		blurb: 'Regular performance opportunities where students share what they’ve been working on.',
	},
];

const whyOpus = [
	'Students are motivated and challenged. They achieve self-discipline and expand their creativity.',
	'Students make friends and meet musicians from all walks of life.',
	'Students develop their performance and communication skills through concerts and recitals.',
	'It’s possible to start learning to play an instrument at any age — our methodology adapts to improve each student’s knowledge.',
];

const faqs = [
	{
		question: 'What can a 3-year-old learn in music lessons?',
		answer:
			'Our curriculum introduces young students to rhythm and beats, recognizing sounds and melodies, fun activities that build fine motor skills, and the foundation for instrument playing and music appreciation.',
	},
	{
		question: 'My child faces unique challenges. Is there a place for them at Opus?',
		answer:
			'Absolutely. We’ve been teaching children with unique strengths and challenges for years — including students on the spectrum, students who are anxious, and students with physical challenges — through Adaptive Lessons led by our music therapists. Our facilities are fully ADA compliant, with wide doors, large classrooms, ramps, and accessible bathrooms, and we can schedule mornings or weekends for more privacy.',
	},
	{
		question: 'Why start music education so early?',
		answer:
			'Research shows early music education boosts cognitive development (memory, focus, problem-solving), creativity and self-expression, social-emotional growth (confidence, patience, teamwork), and motor skills through hands-on practice.',
	},
	{
		question: 'Can I try before committing?',
		answer:
			'Yes — we offer a free trial lesson so a new student can experience the joy of music firsthand and see if they’re ready to begin their musical journey with us.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-media">
					<Image src={HeroImage} alt="" width={1500} height={500} class="hero-banner" />
				</div>
				<div class="hero-content">
					<h1>Individualized music lessons for children and adults</h1>
					<p class="lede">
						A place where every student is unique in their own way — and so are our teaching styles
						and methods. Explore personalized music education with talented instructors at our
						RCM-certified school, across two Virginia studios since 2008.
					</p>
					<div class="hero-actions cluster">
						<a class="button" href="/free-trial">Book a Free Trial</a>
						<a class="button button-outline" href="/instructors">Meet the Instructors</a>
					</div>
				</div>
			</section>

			{/* <Piano keys={12} /> */}

			<section class="mosaic" style="--cols: 2">
				<div class="mosaic-cell">
					<div>
						<h2>Why choose Opus?</h2>
						<ul>
							{whyOpus.map((point) => <li>{point}</li>)}
						</ul>
					</div>
				</div>
				<div
					class="mosaic-cell mosaic-cell--image"
					style={`background-image: url(${MosaicKeys.src}); background-position: center;`}
				>
					<p>
						Explore personalized music education with talented instructors, for all ages at our
						RCM-certified school.
					</p>
				</div>
			</section>

			<section class="mosaic" style="--cols: 3">
				{
					programs.slice(0, 3).map((program, i) => (
						<a
							class={`mosaic-cell ${i % 2 === 0 ? 'mosaic-cell--blue-light' : 'mosaic-cell--blue'}`}
							href={program.href}
						>
							<h3>{program.title}</h3>
						</a>
					))
				}
			</section>

			<section class="mosaic" style="--cols: 3">
				<div class="mosaic-cell mosaic-cell--blue">
					<div>
						<h2>A place</h2>
						<p>
							where every student is unique in their own way, and so are our teaching styles and
							methodology.
						</p>
					</div>
				</div>
				<a
					class="mosaic-cell mosaic-cell--image"
					href="/events"
					style={`background-image: url(${MosaicCalendar.src}); background-position: 20% 25%;`}
				>
					<span class="button">Calendar</span>
				</a>
				<a class="mosaic-cell mosaic-cell--black" href="/about">
					<div>
						<h2>Since 2008</h2>
						<span class="button">Our Story</span>
					</div>
				</a>
			</section>

			<section class="mosaic" style="--cols: 2">
				{
					locations.length > 0 ? (
						locations.map((loc) => (
							<div class="mosaic-cell mosaic-cell--blue-light">
								<div>
									<h3>{loc.name}</h3>
									{loc.address && <p>{loc.address}</p>}
									{loc.phone && (
										<p>
											<a href={`tel:${loc.phone.replace(/[^\d+]/g, '')}`}>{loc.phone}</a>
										</p>
									)}
									{loc.hours && loc.hours.length > 0 && (
										<p>{loc.hours.join(' · ')}</p>
									)}
									<a class="button" href={`/instructors/?location=${loc.slug.current}`}>
										Our Instructors
									</a>
								</div>
							</div>
						))
					) : (
						<p>Studio locations are managed in Sanity — add a "Location" entry to show it here.</p>
					)
				}
			</section>

			<section class="mosaic" style="--cols: 3">
				<div
					class="mosaic-cell mosaic-cell--image"
					style={`background-image: url(${MosaicGuitar.src}); background-position: center 45%;`}
				/>
				<div class="mosaic-cell">
					<div>
						<h2>Our instruments</h2>
						<ul>
							{
								instruments.map((instrument) => (
									<li>
										<a href={`/instructors/?instrument=${slugify(instrument)}`}>{instrument}</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
				<div
					class="mosaic-cell mosaic-cell--image"
					style={`background-image: url(${MosaicGuitar.src}); background-position: center 45%;`}
				/>
			</section>

			<section class="mosaic" style="--cols: 2">
				<a
					class="mosaic-cell mosaic-cell--image"
					href="/events"
					style={`background-image: url(${MosaicPastEvents.src}); background-position: center 35%;`}
				>
					<h3>Past Events</h3>
				</a>
				<a class="mosaic-cell mosaic-cell--blue" href="/free-trial">
					<div>
						<h2>Enrollment</h2>
						<p>Book your first lesson today.</p>
						<span class="button">Free Trial</span>
					</div>
				</a>
			</section>

			<div class="sheet">
				<section class="section">
					<div class="container">
						<h2>Frequently asked questions</h2>
						<div class="stack">
							{
								faqs.map((faq) => (
									<details class="card">
										<summary>{faq.question}</summary>
										<p>{faq.answer}</p>
									</details>
								))
							}
						</div>
					</div>
				</section>

				<section class="section">
					<div class="container">
						<div class="cta-banner">
							<h2>Ready to try a lesson?</h2>
							<p>Your first lesson is on us — tell us your instrument and preferred studio, and we’ll pair you with an instructor.</p>
							<a class="button" href="/free-trial">Book a Free Trial</a>
						</div>
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const heroBanner = document.querySelector<HTMLElement>('.hero-banner');
	const hero = document.querySelector<HTMLElement>('.hero');

	if (heroBanner && hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const speed = 0.35;
		const overhang = 0.15;
		let ticking = false;

		const updateParallax = () => {
			const maxOffset = hero.offsetHeight * overhang;
			const offset = Math.min(window.scrollY * speed, maxOffset);
			heroBanner.style.transform = `translateY(${offset}px)`;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(updateParallax);
			},
			{ passive: true }
		);
	}
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		min-height: min(72vh, 560px);
	}

	.hero-media {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}

	.hero-banner {
		position: absolute;
		top: -15%;
		left: 0;
		width: 100%;
		height: 130%;
		object-fit: cover;
		object-position: 25% center;
		will-change: transform;
	}

	.hero-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--color-ink) 75%, transparent) 0%,
			color-mix(in srgb, var(--color-ink) 45%, transparent) 35%,
			transparent 75%
		);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		padding: 4rem 1.5rem;
		max-width: 640px;
	}

	.hero h1 {
		color: var(--color-light);
		max-width: 560px;
	}

	.hero .lede {
		color: color-mix(in srgb, var(--color-light) 90%, transparent);
		max-width: 560px;
	}

	.hero-actions {
		margin-top: 1.5rem;
	}

	.mosaic {
		display: grid;
		grid-template-columns: repeat(var(--cols, 2), 1fr);
		gap: 1rem;
		padding-inline: 1rem;
		margin-top: 1rem;
	}

	.mosaic-cell {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 320px;
		padding: 2.5rem;
		text-align: center;
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		border-radius: 1rem;
	}

	.mosaic-cell > * {
		position: relative;
		z-index: 1;
	}

	.mosaic-cell h2,
	.mosaic-cell h3 {
		color: inherit;
	}

	.mosaic-cell p,
	.mosaic-cell li {
		font-size: 1.15rem;
	}

	.mosaic-cell ul {
		margin: 0;
		padding-left: 1.2em;
		text-align: left;
	}

	.mosaic-cell ul a {
		color: inherit;
		text-decoration: none;
	}

	.mosaic-cell--blue {
		background: var(--color-heading);
		color: var(--color-light);
	}

	.mosaic-cell--blue-light {
		background: color-mix(in srgb, var(--color-heading) 35%, white);
		color: var(--color-heading);
	}

	.mosaic-cell--black {
		background: var(--palette-original-black);
		color: var(--color-light);
	}

	.mosaic-cell--image {
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		color: var(--color-light);
	}

	.mosaic-cell--image::before {
		content: '';
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--palette-original-black) 45%, transparent);
	}

	@media (max-width: 720px) {
		.mosaic {
			grid-template-columns: 1fr;
		}
		.mosaic-cell--image {
			background-attachment: scroll;
		}
	}

	.sheet {
		max-width: 900px;
		margin: 0 auto;
	}

	.sheet .section {
		padding-block: 2rem;
	}

	.sheet .staff {
		margin-block: 0;
	}

	.sheet h2 {
		text-align: center;
	}

	.cta-banner {
		text-align: center;
		padding: 3rem 2rem;
		border-radius: var(--radius);
		background: var(--accent);
		color: var(--color-light);
	}

	.cta-banner h2 {
		color: var(--color-light);
	}

	.cta-banner .button {
		background: var(--color-light);
		border-color: var(--color-light);
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.hero {
			min-height: min(60vh, 460px);
		}
		.hero-content {
			padding: 2.5rem 1.25rem;
		}
	}
</style>

