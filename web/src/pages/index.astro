---
import { Image } from 'astro:assets';
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import HeroImage from '../assets/hero-piano.jpeg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugify } from '../lib/slugify';

const HOME_LOCATIONS_QUERY = defineQuery(
	`*[_type == "location"] | order(name asc){ _id, name, slug, address, phone, hours }`
);
const locations = await sanityClient.fetch(HOME_LOCATIONS_QUERY).catch(() => []);

const instruments = [
	'Piano',
	'Voice',
	'Guitar',
	'Violin',
	'Cello',
	'Flute',
	'Clarinet',
	'Percussion',
	'Ukulele',
	'Cuatro',
];

const programs = [
	{
		href: '/programs/private-lessons',
		title: 'Private Lessons',
		blurb: 'One-on-one instruction in 30, 45, or 60-minute sessions, matched to each student’s goals and pace.',
	},
	{
		href: '/programs/adaptive-lessons',
		title: 'Adaptive Lessons',
		blurb: 'Individualized instruction for students with learning differences, disabilities, or medical conditions, taught by board-certified music therapists.',
	},
	{
		href: '/programs/music-therapy',
		title: 'Music Therapy',
		blurb: 'Evidence-based sessions guided by board-certified therapists to support growth, healing, and development — no diagnosis required.',
	},
	{
		href: '/programs/summer-camp',
		title: 'Summer Camp',
		blurb: 'A different musical theme every week, from big-band improvisation to scoring for film.',
	},
	{
		href: '/recitals',
		title: 'Recitals',
		blurb: 'Regular performance opportunities where students share what they’ve been working on.',
	},
];

const whyOpus = [
	'Students are motivated and challenged. They achieve self-discipline and expand their creativity.',
	'Students make friends and meet musicians from all walks of life.',
	'Students develop their performance and communication skills through concerts and recitals.',
	'It’s possible to start learning to play an instrument at any age — our methodology adapts to improve each student’s knowledge.',
];

const faqs = [
	{
		question: 'What can a 3-year-old learn in music lessons?',
		answer:
			'Our curriculum introduces young students to rhythm and beats, recognizing sounds and melodies, fun activities that build fine motor skills, and the foundation for instrument playing and music appreciation.',
	},
	{
		question: 'My child faces unique challenges. Is there a place for them at Opus?',
		answer:
			'Absolutely. We’ve been teaching children with unique strengths and challenges for years — including students on the spectrum, students who are anxious, and students with physical challenges — through Adaptive Lessons led by our music therapists. Our facilities are fully ADA compliant, with wide doors, large classrooms, ramps, and accessible bathrooms, and we can schedule mornings or weekends for more privacy.',
	},
	{
		question: 'Why start music education so early?',
		answer:
			'Research shows early music education boosts cognitive development (memory, focus, problem-solving), creativity and self-expression, social-emotional growth (confidence, patience, teamwork), and motor skills through hands-on practice.',
	},
	{
		question: 'Can I try before committing?',
		answer:
			'Yes — we offer a free trial lesson so a new student can experience the joy of music firsthand and see if they’re ready to begin their musical journey with us.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-media">
					<Image src={HeroImage} alt="" width={1500} height={500} class="hero-banner" />
				</div>
				<div class="hero-content">
					<h1>Individualized music lessons for children and adults</h1>
					<p class="lede">
						A place where every student is unique in their own way — and so are our teaching styles
						and methods. Explore personalized music education with talented instructors at our
						RCM-certified school, across two Virginia studios since 2008.
					</p>
					<div class="hero-actions cluster">
						<a class="button" href="/free-trial">Book a Free Trial</a>
						<a class="button button-outline" href="/instructors">Meet the Instructors</a>
					</div>
				</div>
			</section>

			<div class="sheet">
				<div class="staff"></div>

				<section class="section">
					<div class="container">
						<h2>Why choose Opus?</h2>
						<ul class="grid">
							{whyOpus.map((point) => <li class="card">{point}</li>)}
						</ul>
					</div>
				</section>

				<div class="staff"></div>

				<section class="section">
					<div class="container">
						<h2>Instruments we teach</h2>
						<ul class="cluster">
							{
								instruments.map((instrument) => (
									<li>
										<a class="tag" href={`/instructors/?instrument=${slugify(instrument)}`}>
											{instrument}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</section>

				<div class="staff"></div>

				<section class="section">
					<div class="container">
						<h2>Programs</h2>
						<div class="grid">
							{
								programs.map((program) => (
									<a class="card" href={program.href}>
										<h3>{program.title}</h3>
										<p>{program.blurb}</p>
										<span class="link-arrow">Learn more &rarr;</span>
									</a>
								))
							}
						</div>
					</div>
				</section>

				<div class="staff"></div>

				<section class="section">
					<div class="container">
						<h2>Our studios</h2>
						<div class="grid">
							{
								locations.length > 0 ? (
									locations.map((loc) => (
										<div class="card">
											<h3>{loc.name}</h3>
											{loc.address && <p class="muted">{loc.address}</p>}
											{loc.phone && (
												<p class="muted">
													<a href={`tel:${loc.phone.replace(/[^\d+]/g, '')}`}>{loc.phone}</a>
												</p>
											)}
											{loc.hours && loc.hours.length > 0 && (
												<ul class="muted">
													{loc.hours.map((line) => <li>{line}</li>)}
												</ul>
											)}
											<a class="link-arrow" href={`/instructors/?location=${loc.slug.current}`}>
												See {loc.name} instructors &rarr;
											</a>
										</div>
									))
								) : (
									<p>Studio locations are managed in Sanity — add a "Location" entry to show it here.</p>
								)
							}
						</div>
					</div>
				</section>

				<div class="staff"></div>

				<section class="section">
					<div class="container">
						<h2>Frequently asked questions</h2>
						<div class="stack">
							{
								faqs.map((faq) => (
									<details class="card">
										<summary>{faq.question}</summary>
										<p>{faq.answer}</p>
									</details>
								))
							}
						</div>
					</div>
				</section>

				<div class="staff"></div>

				<section class="section">
					<div class="container">
						<div class="cta-banner">
							<h2>Ready to try a lesson?</h2>
							<p>Your first lesson is on us — tell us your instrument and preferred studio, and we’ll pair you with an instructor.</p>
							<a class="button" href="/free-trial">Book a Free Trial</a>
						</div>
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const heroBanner = document.querySelector<HTMLElement>('.hero-banner');
	const hero = document.querySelector<HTMLElement>('.hero');

	if (heroBanner && hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const speed = 0.35;
		const overhang = 0.15;
		let ticking = false;

		const updateParallax = () => {
			const maxOffset = hero.offsetHeight * overhang;
			const offset = Math.min(window.scrollY * speed, maxOffset);
			heroBanner.style.transform = `translateY(${offset}px)`;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(updateParallax);
			},
			{ passive: true }
		);
	}
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		min-height: min(72vh, 560px);
	}

	.hero-media {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}

	.hero-banner {
		position: absolute;
		top: -15%;
		left: 0;
		width: 100%;
		height: 130%;
		object-fit: cover;
		object-position: 25% center;
		will-change: transform;
	}

	.hero-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--color-ink) 75%, transparent) 0%,
			color-mix(in srgb, var(--color-ink) 45%, transparent) 35%,
			transparent 75%
		);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		padding: 4rem 1.5rem;
		max-width: 640px;
	}

	.hero h1 {
		color: var(--color-light);
		max-width: 560px;
	}

	.hero .lede {
		color: color-mix(in srgb, var(--color-light) 90%, transparent);
		max-width: 560px;
	}

	.hero-actions {
		margin-top: 1.5rem;
	}

	.sheet {
		max-width: 900px;
		margin: 0 auto;
	}

	.sheet .section {
		padding-block: 2rem;
	}

	.sheet .staff {
		margin-block: 0;
	}

	.sheet h2 {
		text-align: center;
	}

	.cta-banner {
		text-align: center;
		padding: 3rem 2rem;
		border-radius: var(--radius);
		background: var(--accent);
		color: var(--color-light);
	}

	.cta-banner h2 {
		color: var(--color-light);
	}

	.cta-banner .button {
		background: var(--color-light);
		border-color: var(--color-light);
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.hero {
			min-height: min(60vh, 460px);
		}
		.hero-content {
			padding: 2.5rem 1.25rem;
		}
	}
</style>

