---
import { PortableText } from 'astro-portabletext';
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { slugify } from '../../lib/slugify';
import { urlFor } from '../../lib/sanity';

const INSTRUCTORS_QUERY = defineQuery(
	`*[_type == "instructor"] | order(name asc){ _id, name, title, photo, instruments, bio, email, locations[]->{ _id, name, slug } }`
);
const INSTRUCTORS_PAGE_LOCATIONS_QUERY = defineQuery(
	`*[_type == "location"] | order(name asc){ _id, name, slug, address, phone, hours }`
);

const [instructors, locations] = await Promise.all([
	sanityClient.fetch(INSTRUCTORS_QUERY),
	sanityClient.fetch(INSTRUCTORS_PAGE_LOCATIONS_QUERY).catch(() => []),
]);

const instrumentNamesBySlug = new Map<string, string>();
for (const instructor of instructors) {
	for (const instrument of instructor.instruments ?? []) {
		const slug = slugify(instrument);
		if (!instrumentNamesBySlug.has(slug)) instrumentNamesBySlug.set(slug, instrument);
	}
}
const instruments = [...instrumentNamesBySlug.entries()]
	.map(([slug, name]) => ({ slug, name }))
	.sort((a, b) => a.name.localeCompare(b.name));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Instructors" description="Meet our instructors" />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1 id="instructors-heading">Instructors</h1>

			<div class="cluster">
				<a class="tag filter-pill active" data-filter-key="location" data-slug="" href="/instructors/">
					All Locations
				</a>
				{
					locations.map((loc) => (
						<a
							class="tag filter-pill"
							data-filter-key="location"
							data-slug={loc.slug.current}
							data-name={loc.name}
							data-address={loc.address ?? ''}
							data-phone={loc.phone ?? ''}
							data-hours={JSON.stringify(loc.hours ?? [])}
							href={`/instructors/?location=${loc.slug.current}`}
						>
							{loc.name}
						</a>
					))
				}
			</div>

			<div class="cluster">
				<a class="tag filter-pill active" data-filter-key="instrument" data-slug="" href="/instructors/">
					All Instruments
				</a>
				{
					instruments.map((instrument) => (
						<a
							class="tag filter-pill"
							data-filter-key="instrument"
							data-slug={instrument.slug}
							data-name={instrument.name}
							href={`/instructors/?instrument=${instrument.slug}`}
						>
							{instrument.name}
						</a>
					))
				}
			</div>

			<div class="location-banner" hidden></div>

			<ul class="stack">
				{
					instructors.map((instructor) => (
						<li
							class="card instructor-card"
							data-locations={instructor.locations?.map((loc) => loc.slug.current).join(' ') ?? ''}
							data-instruments={instructor.instruments?.map((name) => slugify(name)).join(' ') ?? ''}
						>
							<div class="instructor-bio">
								<div
									class="instructor-summary"
									role="button"
									tabindex="0"
									aria-expanded="false"
								>
									{instructor.photo ? (
										<img
											src={urlFor(instructor.photo).width(600).height(600).url()}
											alt=""
											width="300"
											height="300"
											class="instructor-photo"
										/>
									) : (
										<div class="instructor-photo instructor-photo-placeholder" aria-hidden="true" />
									)}
									<div class="instructor-info">
										<h2>{instructor.name}</h2>
										{instructor.title && <p class="role">{instructor.title}</p>}
										{instructor.instruments && (
											<p class="muted">{instructor.instruments.join(', ')}</p>
										)}
										{instructor.locations && instructor.locations.length > 0 && (
											<p class="muted">
												{instructor.locations.map((loc) => loc.name).join(' · ')}
											</p>
										)}
										{(instructor.bio || instructor.email) && (
											<span class="bio-toggle">Bio</span>
										)}
									</div>
								</div>
								{(instructor.bio || instructor.email) && (
									<div class="bio-content">
										<div class="bio-content-inner">
											{instructor.bio && <PortableText value={instructor.bio} />}
											{instructor.email && (
												<p class="email">
													<a href={`mailto:${instructor.email}`}>{instructor.email}</a>
												</p>
											)}
										</div>
									</div>
								)}
							</div>
						</li>
					))
				}
			</ul>

			<p class="muted empty-message" hidden>No instructors match these filters yet.</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	function applyFilters() {
		const params = new URLSearchParams(window.location.search);
		const locationSlug = params.get('location') ?? '';
		const instrumentSlug = params.get('instrument') ?? '';

		const pills = document.querySelectorAll<HTMLAnchorElement>('.filter-pill');
		pills.forEach((pill) => {
			const current = pill.dataset.filterKey === 'instrument' ? instrumentSlug : locationSlug;
			pill.classList.toggle('active', (pill.dataset.slug ?? '') === current);
		});

		const activeLocationPill = locationSlug
			? document.querySelector<HTMLAnchorElement>(
					`.filter-pill[data-filter-key="location"][data-slug="${CSS.escape(locationSlug)}"]`
				)
			: null;
		const activeInstrumentPill = instrumentSlug
			? document.querySelector<HTMLAnchorElement>(
					`.filter-pill[data-filter-key="instrument"][data-slug="${CSS.escape(instrumentSlug)}"]`
				)
			: null;

		const cards = document.querySelectorAll<HTMLLIElement>('.instructor-card');
		let visibleCount = 0;
		cards.forEach((card) => {
			const cardLocations = (card.dataset.locations ?? '').split(' ').filter(Boolean);
			const cardInstruments = (card.dataset.instruments ?? '').split(' ').filter(Boolean);
			const matchesLocation = !locationSlug || cardLocations.includes(locationSlug);
			const matchesInstrument = !instrumentSlug || cardInstruments.includes(instrumentSlug);
			const matches = matchesLocation && matchesInstrument;
			card.hidden = !matches;
			if (matches) visibleCount += 1;
		});

		const emptyMessage = document.querySelector<HTMLElement>('.empty-message');
		if (emptyMessage) emptyMessage.hidden = visibleCount > 0;

		const heading = document.querySelector<HTMLElement>('#instructors-heading');
		if (heading) {
			const parts = [activeLocationPill?.dataset.name, activeInstrumentPill?.dataset.name].filter(
				Boolean
			);
			heading.textContent = parts.length > 0 ? `${parts.join(' · ')} Instructors` : 'Instructors';
		}

		const banner = document.querySelector<HTMLElement>('.location-banner');
		if (banner) {
			banner.innerHTML = '';
			if (activeLocationPill) {
				const { address, phone, hours } = activeLocationPill.dataset;
				if (address) {
					const span = document.createElement('span');
					span.textContent = address;
					banner.append(span);
				}
				if (phone) {
					const span = document.createElement('span');
					const link = document.createElement('a');
					link.href = `tel:${phone.replace(/[^\d+]/g, '')}`;
					link.textContent = phone;
					span.append(link);
					banner.append(span);
				}
				for (const line of JSON.parse(hours || '[]')) {
					const span = document.createElement('span');
					span.textContent = line;
					banner.append(span);
				}
				banner.hidden = false;
			} else {
				banner.hidden = true;
			}
		}
	}

	applyFilters();
	window.addEventListener('popstate', applyFilters);

	document.querySelectorAll<HTMLAnchorElement>('.filter-pill').forEach((pill) => {
		pill.addEventListener('click', (event) => {
			event.preventDefault();
			const key = pill.dataset.filterKey;
			const slug = pill.dataset.slug ?? '';
			if (!key) return;

			const params = new URLSearchParams(window.location.search);
			if (slug) {
				params.set(key, slug);
			} else {
				params.delete(key);
			}

			const query = params.toString();
			window.history.pushState({}, '', `/instructors/${query ? `?${query}` : ''}`);
			applyFilters();
		});
	});

	document.querySelectorAll<HTMLElement>('.instructor-bio').forEach((card) => {
		const trigger = card.querySelector<HTMLElement>('.instructor-summary');
		if (!trigger) return;

		const toggle = () => {
			const isOpen = card.classList.toggle('is-open');
			trigger.setAttribute('aria-expanded', String(isOpen));
		};

		trigger.addEventListener('click', toggle);
		trigger.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			toggle();
		});
	});
</script>

<style>
	.filter-pill.active {
		background: var(--accent);
		color: var(--color-light);
	}

	.location-banner {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin-bottom: 1.5rem;
		padding: 0.85rem 1.1rem;
		border-radius: var(--radius);
		background: var(--color-light);
		border: 1px solid var(--color-staff);
		font-size: 0.9rem;
	}
	.location-banner[hidden] {
		display: none;
	}

	.instructor-summary {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 1.5rem;
		cursor: pointer;
	}

	.instructor-photo {
		display: block;
		border-radius: var(--radius);
		object-fit: cover;
		aspect-ratio: 1 / 1;
		width: 100%;
		height: auto;
	}
	.instructor-photo-placeholder {
		background: var(--color-staff);
	}

	.instructor-info h2 {
		margin: 0;
	}
	.role {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent);
	}

	.bio-toggle {
		display: inline-block;
		margin-top: 0.5rem;
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--accent);
	}
	.bio-toggle::before {
		content: '▸';
		display: inline-block;
		margin-right: 0.4em;
		transition: transform 0.15s ease;
	}
	.instructor-bio.is-open .bio-toggle::before {
		transform: rotate(90deg);
	}

	.bio-content {
		position: relative;
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transition: max-height 0.5s ease, opacity 0.35s ease;
	}
	.instructor-bio.is-open .bio-content {
		max-height: 1400px;
		opacity: 1;
	}
	.bio-content-inner {
		border-top: 1px solid var(--color-staff);
		padding-top: 1rem;
		font-size: 0.95rem;
	}
	.bio-content .email {
		margin-top: 0.75rem;
	}

	@media (max-width: 520px) {
		.instructor-summary {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.instructor-photo,
		.instructor-photo-placeholder {
			max-width: 200px;
			margin: 0 auto;
		}
	}
</style>
