---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = 'About Opus Conservatory';
const description = 'How Opus Conservatory grew from a four-student piano studio into a two-location music school.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="about">
			<h1>About Opus Conservatory</h1>

			<p class="lede">
				Opus Conservatory began in 2008 as a single piano studio run by founder and director
				Marisela Smith, who trained at the National Music Conservatory in Caracas, Venezuela and
				studied under Professor Sidonia Stern in Germany. That first year, she taught four
				students. Today the school serves more than 200 students across two Virginia locations.
			</p>

			<p>
				Our teaching follows the Royal Conservatory Music Development Program, a nationally
				recognized curriculum that gives students clear, structured milestones as they progress —
				whether they're headed toward performance, exams, or simply playing for the love of it.
				Alongside private instruction, we run an early-childhood program, adaptive lessons for
				students with disabilities and learning differences, and a music therapy practice led by a
				board-certified music therapist.
			</p>

			<p>
				Both studios are single-floor and wheelchair accessible, with wide doorways and accessible
				restrooms, so lessons are available to students of every ability. We host recitals twice a
				year and welcome new students of any age with a complimentary trial lesson.
			</p>

			<div class="stats">
				<div class="stat">
					<span class="stat-number">2008</span>
					<span class="stat-label">Founded</span>
				</div>
				<div class="stat">
					<span class="stat-number">200+</span>
					<span class="stat-label">Students</span>
				</div>
				<div class="stat">
					<span class="stat-number">2</span>
					<span class="stat-label">Virginia studios</span>
				</div>
				<div class="stat">
					<span class="stat-number">10</span>
					<span class="stat-label">Instruments taught</span>
				</div>
			</div>

			<div class="about-cta">
				<a class="button" href="/instructors">Meet our instructors</a>
				<a class="button button-outline" href="/free-trial">Book a free trial</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		max-width: 720px;
	}
	.lede {
		font-size: 1.15rem;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 1.5rem;
		margin: 2.5rem 0;
		text-align: center;
	}
	.stat {
		display: flex;
		flex-direction: column;
		padding: 1.25rem 0.5rem;
		border-radius: 14px;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 4%);
	}
	.stat-number {
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent);
	}
	.stat-label {
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.about-cta {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.button {
		display: inline-block;
		padding: 0.75em 1.5em;
		border-radius: 999px;
		background: var(--accent);
		color: white;
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent-dark);
		color: white;
	}
	.button-outline {
		background: transparent;
		color: var(--accent);
		border: 2px solid var(--accent);
	}
	.button-outline:hover {
		background: var(--accent);
		color: white;
	}
</style>
