---
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { urlFor } from '../../lib/sanity';

const GALLERIES_QUERY = defineQuery(
	`*[_type == "gallery" && defined(slug.current)] | order(title asc){ _id, title, slug, "cover": images[0] }`
);

const galleries = await sanityClient.fetch(GALLERIES_QUERY);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Galleries" description="Photo galleries from Opus Conservatory recitals and events" />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1>Galleries</h1>
			{galleries.length === 0 && <p class="muted">Galleries will show up here once photos are added.</p>}
			<div class="grid">
				{
					galleries.map((gallery) => (
						<a class="card" href={`/galleries/${gallery.slug.current}/`}>
							{gallery.cover ? (
								<img src={urlFor(gallery.cover).width(500).height(350).url()} alt={gallery.cover.alt ?? ''} />
							) : (
								<div class="cover-placeholder" aria-hidden="true" />
							)}
							<h2>{gallery.title}</h2>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.cover-placeholder {
		aspect-ratio: 10 / 7;
		border-radius: var(--radius);
		background: var(--color-staff);
	}
</style>
