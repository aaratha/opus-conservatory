---
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { urlFor } from '../../lib/sanity';

const GALLERIES_QUERY = defineQuery(
	`*[_type == "gallery" && defined(slug.current)] | order(title asc){ _id, title, slug, "cover": images[0] }`
);

const galleries = await sanityClient.fetch(GALLERIES_QUERY);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Galleries" description="Photo galleries from Opus Conservatory recitals and events" />
	</head>
	<body>
		<Header />
		<main class="content-page">
			<h1>Galleries</h1>
			{galleries.length === 0 && <p class="empty">Galleries will show up here once photos are added.</p>}
			<div class="gallery-grid">
				{
					galleries.map((gallery) => (
						<a class="card gallery-card" href={`/galleries/${gallery.slug.current}/`}>
							{gallery.cover ? (
								<img src={urlFor(gallery.cover).width(500).height(350).url()} alt={gallery.cover.alt ?? ''} />
							) : (
								<div class="gallery-cover-placeholder" aria-hidden="true" />
							)}
							<h2>{gallery.title}</h2>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.empty {
		color: rgb(var(--gray));
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.25rem;
	}
	.gallery-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0.75rem;
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.gallery-card:hover {
		box-shadow: 0 8px 20px rgba(var(--black), 8%);
		transform: translateY(-2px);
	}
	.gallery-card img {
		border-radius: 10px;
		width: 100%;
		aspect-ratio: 10 / 7;
		object-fit: cover;
	}
	.gallery-cover-placeholder {
		border-radius: 10px;
		width: 100%;
		aspect-ratio: 10 / 7;
		background: rgb(var(--gray-light));
	}
	.gallery-card h2 {
		margin: 0;
		font-size: 1.15rem;
	}
</style>
