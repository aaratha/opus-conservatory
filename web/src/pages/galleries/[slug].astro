---
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
	const GALLERY_SLUGS_QUERY = defineQuery(
		`*[_type == "gallery" && defined(slug.current)]{ "params": { "slug": slug.current } }`
	);
	return await sanityClient.fetch(GALLERY_SLUGS_QUERY);
}

const GALLERY_QUERY = defineQuery(
	`*[_type == "gallery" && slug.current == $slug][0]{ title, images }`
);

const { slug } = Astro.params;
const gallery = await sanityClient.fetch(GALLERY_QUERY, { slug });

if (!gallery) throw new Error(`Gallery not found: ${slug}`);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={gallery.title} description={gallery.title} />
	</head>
	<body>
		<Header />
		<main class="content-page">
			<h1>{gallery.title}</h1>
			<div class="grid">
				{
					gallery.images?.map((image) => (
						<figure class="card">
							<img src={urlFor(image).width(600).url()} alt={image.alt ?? ''} />
							{image.caption && <figcaption>{image.caption}</figcaption>}
						</figure>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.25rem;
	}
	figure.card {
		margin: 0;
		padding: 0.75rem;
	}
	figure img {
		display: block;
		border-radius: 10px;
		width: 100%;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
</style>
