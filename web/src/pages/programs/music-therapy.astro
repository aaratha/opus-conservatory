---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const title = 'Music Therapy';
const description = 'Board-certified music therapy sessions for clients of all ages and ability levels.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1>Music Therapy</h1>
			<p class="lede">
				Music therapy uses the power of music, guided by board-certified therapists, to support
				growth, healing, and development. At Opus Conservatory, our sessions are evidence-based,
				personalized, and designed to meet each individual's needs.
			</p>

			<h2>Who can benefit</h2>
			<p>
				Music therapy is available to individuals of all ages and abilities — no specific diagnosis
				or qualifications are required. It provides a safe, creative, and effective way to support
				growth, healing, and development, including:
			</p>
			<ul>
				<li>Mental health and emotional well-being</li>
				<li>Autism and behavioral support</li>
				<li>Early intervention and developmental skills</li>
				<li>Speech and language development</li>
				<li>Fine and gross motor skills</li>
				<li>Support for individuals experiencing chronic or acute pain</li>
			</ul>

			<h2>Goals of music therapy</h2>
			<p>
				Through carefully designed music interventions, our therapists address a wide range of
				non-musical goals: stress management and relaxation, pain reduction, emotional expression and
				self-awareness, communication and speech improvement, development of fine and gross motor
				skills, academic readiness and learning support, behavioral and emotional regulation, and
				opportunities for socialization and interaction.
			</p>

			<h2>Our approach</h2>
			<p>
				Our music therapy team collaborates with clients, families, and care providers to create a
				holistic and individualized treatment plan. Sessions incorporate patient-preferred music,
				adaptive instruments, and sensory supports to ensure meaningful and effective experiences.
			</p>

			<h2>Our facilities</h2>
			<p>
				Our facilities are ADA compliant and sessions are provided by our board-certified music
				therapist (MT-BC), Emily Perry. Access to the building is by ramp or stairs, all classrooms
				are on one floor, doors are wide, classrooms are large enough to accommodate wheelchairs, and
				bathrooms are ADA accessible. To learn more or to set up a free trial with one of our music
				therapists, email <a href="mailto:Emily.Perry@opusconservatory.com">Emily.Perry@opusconservatory.com</a>.
			</p>

			<div class="cluster">
				<a class="button" href="/free-trial">Ask About a Session</a>
				<a class="button button-outline" href="/programs/adaptive-lessons">See Adaptive Lessons</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
