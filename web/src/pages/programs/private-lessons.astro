---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const title = 'Private Lessons';
const description = 'One-on-one music lessons across ten instruments, in 30, 45, or 60-minute sessions.';

const instruments = [
	'Piano',
	'Voice',
	'Guitar',
	'Violin',
	'Cello',
	'Flute',
	'Clarinet',
	'Percussion',
	'Ukulele',
	'Cuatro',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1>Private Lessons</h1>
			<p class="lede">
				At Opus, we teach life skills, retain our students, and see them off to the best high schools
				and colleges. Our proprietary teaching methods enable us to start with children as young as
				three, and we keep our students engaged for the many years it takes to build their mastery,
				self-confidence, and performance skills.
			</p>

			<h2>How lessons are structured</h2>
			<p>
				Weekly lessons run 30, 45, or 60 minutes depending on the age and level of the student. We
				tailor our lessons to you or your student: students learn classical pieces, but we can also
				teach a folk song from their culture or a favorite piece from an anime or film. Instruction
				follows the Royal Conservatory Music Development Program, a curriculum providing measurable
				standards of musical achievement across North America, so students can track their progress
				through each level. Students also learn the skills, techniques, and confidence to perform in
				front of an audience at our recitals.
			</p>

			<h2>Instruments</h2>
			<ul class="cluster">
				{instruments.map((instrument) => <li><span class="tag">{instrument}</span></li>)}
			</ul>

			<p>
				Not sure which instrument or instructor is the right fit? A complimentary trial lesson is
				the easiest way to find out.
			</p>

			<div class="cluster">
				<a class="button" href="/free-trial">Book a Free Trial</a>
				<a class="button button-outline" href="/instructors">Meet the Instructors</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
