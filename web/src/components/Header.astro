---
import { defineQuery } from 'groq';
import { sanityClient } from 'sanity:client';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const HEADER_LOCATIONS_QUERY = defineQuery(
	`*[_type == "location"] | order(name asc){ _id, name, slug, address, phone }`
);
const locations = await sanityClient.fetch(HEADER_LOCATIONS_QUERY).catch(() => []);

const programs = [
	{ href: '/programs/private-lessons', label: 'Private Lessons' },
	{ href: '/programs/adaptive-lessons', label: 'Adaptive Lessons' },
	{ href: '/programs/music-therapy', label: 'Music Therapy' },
	{ href: '/programs/summer-camp', label: 'Summer Camp' },
	{ href: '/recitals', label: 'Recitals' },
];
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<img src="/logo.svg" alt="" width="48" height="48" class="brand-logo" />
				<span class="brand-text">{SITE_TITLE}</span>
			</a>
		</h2>

		<input type="checkbox" id="nav-toggle" class="nav-toggle-input" />

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>

			<div class="dropdown">
				<a class="dropdown-trigger" href="/programs" aria-haspopup="true">
					Programs <span class="caret" aria-hidden="true">▾</span>
				</a>
				<div class="dropdown-menu">
					{
						programs.map((program) => (
							<a class="dropdown-item" href={program.href}>
								{program.label}
							</a>
						))
					}
				</div>
			</div>

			<div class="dropdown">
				<a class="dropdown-trigger" href="/instructors" aria-haspopup="true">
					Instructors <span class="caret" aria-hidden="true">▾</span>
				</a>
				<div class="dropdown-menu">
					{
						locations.map((loc) => (
							<a class="dropdown-item location-item" href={`/instructors?location=${loc.slug.current}`}>
								<span class="location-name">{loc.name}</span>
								{loc.address && <span class="location-detail">{loc.address}</span>}
								{loc.phone && <span class="location-detail">{loc.phone}</span>}
							</a>
						))
					}
					<a class="dropdown-item dropdown-item-all" href="/instructors">All Instructors</a>
				</div>
			</div>

			<HeaderLink href="/events">Events</HeaderLink>
			<HeaderLink href="/galleries">Galleries</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="nav-right">
			<div class="cta-links">
				<a class="button" href="/free-trial">Free Trial</a>
			</div>
			<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
				<span></span>
				<span></span>
				<span></span>
			</label>
		</div>
	</nav>
</header>
<script>
	const header = document.querySelector('header');
	const navToggle = document.getElementById('nav-toggle');

	if (header) {
		const HIDE_AFTER = 80;
		let lastScrollY = window.scrollY;
		let ticking = false;

		const update = () => {
			const currentScrollY = window.scrollY;
			const menuOpen = navToggle instanceof HTMLInputElement && navToggle.checked;

			if (menuOpen || currentScrollY <= HIDE_AFTER) {
				header.classList.remove('nav-hidden');
			} else if (currentScrollY > lastScrollY) {
				header.classList.add('nav-hidden');
			} else if (currentScrollY < lastScrollY) {
				header.classList.remove('nav-hidden');
			}

			lastScrollY = currentScrollY;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(update);
					ticking = true;
				}
			},
			{ passive: true }
		);
	}
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #ffffff;
		position: sticky;
		top: 0;
		z-index: 10;
		transform: translateY(0);
		transition: transform 0.25s ease;
	}
	header.nav-hidden {
		transform: translateY(-100%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: var(--black);
	}
	.brand-logo {
		display: block;
		width: 48px;
		height: 48px;
		flex-shrink: 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	nav > .internal-links > :global(a) {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav :global(a.active) {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		display: flex;
		align-items: center;
		gap: 0.3em;
		padding: 1em 0.5em;
		background: none;
		border: none;
		border-bottom: 4px solid transparent;
		font: inherit;
		font-size: 1em;
		color: var(--black);
		text-decoration: none;
		cursor: pointer;
	}
	.caret {
		font-size: 0.7em;
		color: rgb(var(--gray));
	}
	.dropdown-menu {
		display: flex;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 220px;
		background: white;
		border-radius: 10px;
		box-shadow: var(--box-shadow);
		padding: 0.5em;
		flex-direction: column;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
	}
	.dropdown:hover .dropdown-menu,
	.dropdown:focus-within .dropdown-menu {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
	}
	.dropdown:hover .dropdown-trigger,
	.dropdown:focus-within .dropdown-trigger {
		border-bottom-color: var(--accent);
	}
	.dropdown-item {
		display: flex;
		flex-direction: column;
		padding: 0.6em 0.75em;
		border-radius: 6px;
		text-decoration: none;
		color: var(--black);
		font-size: 0.95rem;
	}
	.dropdown-item:hover {
		background: rgb(var(--gray-light));
	}
	.location-name {
		font-weight: 700;
	}
	.location-detail {
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.dropdown-item-all {
		margin-top: 0.25em;
		border-top: 1px solid rgba(var(--gray), 20%);
		padding-top: 0.6em;
		font-weight: 600;
		color: var(--accent);
	}

	.cta-links .button {
		display: inline-block;
		padding: 0.6em 1.25em;
		border-radius: 999px;
		background: var(--accent);
		color: white;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}
	.cta-links .button:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(35, 55, 255, 0.35);
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1em;
	}

	.nav-toggle-input {
		display: none;
	}
	.nav-toggle-label {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		cursor: pointer;
	}
	.nav-toggle-label span {
		display: block;
		height: 3px;
		width: 100%;
		background: rgb(var(--black));
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.nav-toggle-input:checked ~ .nav-right .nav-toggle-label span:nth-child(1) {
		transform: translateY(8px) rotate(45deg);
	}
	.nav-toggle-input:checked ~ .nav-right .nav-toggle-label span:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle-input:checked ~ .nav-right .nav-toggle-label span:nth-child(3) {
		transform: translateY(-8px) rotate(-45deg);
	}

	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			padding: 0.5em 0;
		}
		.brand-text {
			display: none;
		}
		.nav-toggle-label {
			display: flex;
		}
		.internal-links {
			display: none;
			order: 3;
			flex-basis: 100%;
			flex-direction: column;
			align-items: stretch;
			flex-wrap: wrap;
		}
		.nav-toggle-input:checked ~ .internal-links {
			display: flex;
		}
		.dropdown-menu {
			display: flex;
			position: static;
			box-shadow: none;
			border: 1px solid rgba(var(--gray), 20%);
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
			transition: none;
		}
	}
</style>
